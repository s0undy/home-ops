{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    ':dependencyDashboard',
    ':disableRateLimiting',
    ':semanticCommits',
  ],
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard :robot:',
  },
  timezone: 'Europe/Stockholm',
  schedule: [
    'every weekend',
  ],
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: false,
  automergeSchedule: [
    '* 6-20 * * 1-4',
  ],
  rebaseWhen: 'conflicted',
  ignorePaths: [
    '**/*.sops.*',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/',
      '/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/^kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: 'Override Helmfile Dependency Name',
      matchDatasources: [
        'docker',
      ],
      matchManagers: [
        'helmfile',
      ],
      overrideDepName: '{{packageName}}',
    },
    {
      description: 'Flux Operator Group',
      groupName: 'flux-operator',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
        '/flux-operator-manifests/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 3,
    },
    {
      description: 'Eneo Group',
      groupName: 'eneo',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/eneo-ai/eneo-backend',
        'ghcr.io/eneo-ai/eneo-frontend',
        'ghcr.io/eneo-ai/eneo-tool-runtime',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Rook-Ceph Group',
      groupName: 'rook-ceph',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/rook/rook-ceph',
        'ghcr.io/rook/rook-ceph-cluster',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Auto-merge GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Automerge low-stakes apps',
      matchFileNames: [
        'kubernetes/apps/ai/searxng/**',
        'kubernetes/apps/default/**',
        'kubernetes/apps/media/flaresolverr/**',
        'kubernetes/apps/media/prowlarr/**',
        'kubernetes/apps/media/qbittorrent/**',
        'kubernetes/apps/media/radarr/**',
        'kubernetes/apps/media/sonarr/**',
        'kubernetes/apps/o11y/kromgo/**',
        'kubernetes/apps/o11y/pve-exporter/**',
        'kubernetes/apps/o11y/snmp-exporter/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Automerge stable infrastructure, patch and digest only',
      matchFileNames: [
        'kubernetes/apps/kube-system/metrics-server/**',
        'kubernetes/apps/kube-system/reloader/**',
        'kubernetes/apps/o11y/victoria-logs/**',
      ],
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Automerge the ARC runner image, GitHub retires old runners',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/actions-runner',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Automerge postgres-init rebuilds of the pinned tag',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/postgres-init',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Automerge local CLI tools, except cluster-bound ones',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '!aqua:fluxcd/flux2',
        '!aqua:kubernetes/kubernetes/kubectl',
        '!aqua:siderolabs/talos',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      minimumReleaseAge: '3 days',
      automerge: true,
    },
    {
      description: 'CoreDNS 1.14.3+ prefetch poisons autopath answers, hold until coredns/coredns#8390 is fixed',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/coredns/charts/coredns',
      ],
      enabled: false,
    },
    {
      description: 'Nextcloud Office tags patch builds as vX.Y.Z-N, which docker versioning would treat as a separate compatibility line; also skips -rc.N and per-arch tags',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/nextcloud-releases/office-documentserver',
      ],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<build>\\d+))?$',
    },
    {
      description: 'SearXNG tags are YYYY.M.D-<commit>, which docker versioning would treat as a separate compatibility line per commit',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/searxng/searxng',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$',
    },
    {
      description: "Postgres majors are manual: a CNPG imageName major bump runs pg_upgrade, and postgres-init must match the cluster's major",
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
        'ghcr.io/home-operations/postgres-init',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      semanticCommitType: 'feat',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}})!:',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '( {{currentVersion}} ➔ {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'chore',
      commitMessageExtra: '( {{currentDigestShort}} ➔ {{newDigestShort}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      semanticCommitScope: 'container',
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchDatasources: [
        'helm',
      ],
      semanticCommitScope: 'helm',
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'github-action',
      commitMessageTopic: 'action {{depName}}',
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      semanticCommitScope: 'github-release',
      commitMessageTopic: 'release {{depName}}',
    },
    {
      matchManagers: [
        'mise',
      ],
      semanticCommitScope: 'mise',
      commitMessageTopic: 'tool {{depName}}',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'type/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      labels: [
        'type/digest',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/container',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      addLabels: [
        'renovate/helm',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-action',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      addLabels: [
        'renovate/github-release',
      ],
    },
  ],
  customManagers: [
    {
      description: 'Process annotated dependencies',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/).+\\.env(?:\\.j2)?$/',
        '/(^|/).+\\.sh(?:\\.j2)?$/',
        '/(^|/).+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)',
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process OCI dependencies',
      managerFilePatterns: [
        '/\\.yaml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'oci://(?<depName>[^:]+):(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Process CloudNativePG Cluster imageName, which the kubernetes manager does not match',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'imageName:\\s*["\']?(?<depName>[^\\s:@"\']+):(?<currentValue>[^\\s@"\']+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
